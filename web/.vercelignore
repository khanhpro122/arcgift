# Never upload local env files, test code or local build dirs. The app needs no env vars:
# every network value comes from src/config/networks.json.
.env*
e2e/
testnet/
# Test runner configs import e2e/ and testnet/; next build type-checks every .ts it finds.
playwright.config.ts
vitest.config.mts
vitest.testnet.config.mts
test-results/
playwright-report/
.next/
.next-e2e/
.next-prod/
